# ------------------------------------------------------------------------------
# Qyverion Platform Environment Configuration Template
# ------------------------------------------------------------------------------
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the project root: cp .env.example .env
# 2. Update the credentials and settings with your local development configuration.
# 3. Never commit the actual '.env' file to source control.
# ------------------------------------------------------------------------------

# Project Configuration
PROJECT_NAME="Qyverion"
VERSION="1.0.0"
ENVIRONMENT="development"  # Options: development, staging, production, testing

# FastAPI Web Server Configuration
HOST="127.0.0.1"
PORT=8000
DEBUG=true
API_V1_STR="/api/v1"

# CORS Configuration
# JSON-formatted list of allowed origins. Example: '["http://localhost:3000", "http://127.0.0.1:8000"]'
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:8000", "http://localhost:8000"]'

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="qyverion"

# Database Connection URL (Constructed dynamically in code if omitted)
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/qyverion"

# Security Configurations
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="replace_this_with_a_secure_random_hex_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
